# RPA Vagas - Environment Variables Template
# Preencha suas credenciais no arquivo .env local (nunca comite o .env)

TELEGRAM_BOT_TOKEN=seu_token_telegram_aqui
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# SMTP Email Configuration (para candidaturas automatizadas por e-mail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu_email@exemplo.com
SMTP_PASSWORD=

# Matching Score Thresholds
MIN_MATCH_SCORE_TO_APPLY=75
MIN_MATCH_SCORE_TO_NOTIFY=60

# Candidate Profile Overrides
CANDIDATE_NAME="Candidato Exemplo"
CANDIDATE_OAB="OAB/SP 000.000"
CANDIDATE_PHONE="+5511999999999"
CANDIDATE_EMAIL="candidato@exemplo.com"
